<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>fuse</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fuse</ToolCommandName>
    <PackageId>Fuse</PackageId>
    <Description>Faster C# compiler feedback and affected-test runs for AI coding agents, delivered through agent hooks and a small MCP server.</Description>
    <PackageTags>dotnet-tool;ai-agent;roslyn;claude-code;hooks;mcp;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/Litenova-Solutions/Fuse</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Harnesses/opencode-plugin.js" LogicalName="Fuse.Harnesses.opencode-plugin.js" />
    <InternalsVisibleTo Include="Fuse.Tests" />
    <InternalsVisibleTo Include="Fuse.Evals" />
  </ItemGroup>

  <!-- nuget.org renders no image with a relative path, so the packed README points the repository's images at this version's tag, which the publish workflow packs from. -->
  <Target Name="PackReadmeWithImageUrls" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <PackedReadme>$(IntermediateOutputPath)README.md</PackedReadme>
      <PackedReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../README.md').Replace('](site/', '](https://raw.githubusercontent.com/Litenova-Solutions/Fuse/v$(Version)/site/'))</PackedReadmeText>
    </PropertyGroup>
    <WriteLinesToFile File="$(PackedReadme)" Lines="$([MSBuild]::Escape($(PackedReadmeText)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(PackedReadme)" Pack="true" PackagePath="/" />
    </ItemGroup>
  </Target>

</Project>
