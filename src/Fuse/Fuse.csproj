<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>fuse</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fuse</ToolCommandName>
    <PackageId>Fuse</PackageId>
    <Description>Faster .NET build and test loop for AI coding agents: reports only the compiler errors an edit caused, runs only the affected tests, and shares one process between subagents. Runs through agent hooks and a small MCP server.</Description>
    <PackageTags>dotnet-tool;ai-agent;roslyn;claude-code;hooks;mcp;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/Litenova-Solutions/Fuse</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The client ships compiled ahead of time to native code for win-x64, linux-x64, linux-arm64 and osx-arm64, and as
         fuse.dll on the shared framework everywhere else. The musl RIDs get framework-dependent packages of their own
         because the RID graph maps them to the glibc RIDs, whose native client cannot run on musl. The analyzers run in
         every build, so client code that would break the native client fails the build; the engine's code reaches no
         annotated member. .github/workflows/package.yml packs each package. -->
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-arm64;linux-musl-x64;linux-musl-arm64;any</ToolPackageRuntimeIdentifiers>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!-- PublishAot only for a native pack or publish (-r win-x64 and so on) and for the pointer package (-p:PublishAot=true).
       Set on a plain build it would also turn off dynamic code in fuse.runtimeconfig.json, which the engine runs with. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'any'">
    <PublishAot>true</PublishAot>
    <!-- Roslyn, MSBuild and System.Composition run only in the engine, never in the native client. -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    <!-- The native client's symbols are far larger than the client; the package carries the engine's fuse.pdb. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Harnesses/opencode-plugin.js" LogicalName="Fuse.Harnesses.opencode-plugin.js" />
    <InternalsVisibleTo Include="Fuse.Tests" />
    <InternalsVisibleTo Include="Fuse.Evals" />
  </ItemGroup>

  <!-- The native client cannot run the engine, so a native publish, and with it each RID-specific tool package, also
       carries the engine: this project published for the shared framework, without an apphost, into the same folder.
       EngineVersion reads the module id of that fuse.dll, so the native client and the engine it starts agree on the
       build. It builds into bin/engine and obj/engine, because building into the usual folders without an apphost would
       make MSBuild's incremental clean delete the fuse.exe apphost of a normal build there. -->
  <Target Name="PublishEngineBesideNativeClient" AfterTargets="Publish" Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             RemoveProperties="RuntimeIdentifier;PublishAot;SelfContained;_IsPublishing;NoBuild"
             Properties="UseAppHost=false;PublishDir=$([MSBuild]::NormalizeDirectory($(PublishDir)));OutputPath=$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), 'bin', 'engine', $(Configuration)));IntermediateOutputPath=$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), 'obj', 'engine', $(Configuration)))" />
  </Target>

  <!-- On Windows the SDK installs a native tool behind a fuse.cmd batch file, which Git Bash, the shell Claude Code runs
       hooks in, cannot run. So the win-x64 package is framework-dependent, and its packaged shim, which dotnet tool
       install copies by file name to the tools directory as the fuse command, is the native client published before
       the pack:
         dotnet publish -r win-x64 -o <dir>
         dotnet pack -r win-x64 -p:PublishAot=false -p:UseAppHost=false -p:PackAsToolShimRuntimeIdentifiers=win-x64 -p:NativeClientShim=<dir>/fuse.exe
       dotnet tool run and tool manifests still run fuse.dll on the shared framework. -->
  <Target Name="UseNativeClientAsPackagedShim" AfterTargets="GenerateShimsAssets" Condition="'$(NativeClientShim)' != ''">
    <Error Condition="'$(PackAsToolShimRuntimeIdentifiers)' == ''" Text="NativeClientShim needs PackAsToolShimRuntimeIdentifiers, or the SDK generates no shim to replace." />
    <Error Condition="!Exists('$(NativeClientShim)')" Text="NativeClientShim '$(NativeClientShim)' does not exist." />
    <PropertyGroup>
      <_NativeClientShimTarget>$([MSBuild]::NormalizePath($(PackagedShimOutputRootDirectory), 'shims', $(_ToolPackShortTargetFrameworkName), $(RuntimeIdentifier), '$(ToolCommandName).exe'))</_NativeClientShimTarget>
    </PropertyGroup>
    <Error Condition="!Exists('$(_NativeClientShimTarget)')" Text="The SDK generated no shim at '$(_NativeClientShimTarget)'; its packaged shim layout changed." />
    <Copy SourceFiles="$(NativeClientShim)" DestinationFiles="$(_NativeClientShimTarget)" SkipUnchangedFiles="false" />
  </Target>

  <!-- nuget.org renders no image with a relative path, so the packed README points the repository's images at this version's tag, which the publish workflow packs from. -->
  <Target Name="PackReadmeWithImageUrls" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <PackedReadme>$(IntermediateOutputPath)README.md</PackedReadme>
      <PackedReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../README.md').Replace('](site/', '](https://raw.githubusercontent.com/Litenova-Solutions/Fuse/v$(Version)/site/'))</PackedReadmeText>
    </PropertyGroup>
    <WriteLinesToFile File="$(PackedReadme)" Lines="$([MSBuild]::Escape($(PackedReadmeText)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(PackedReadme)" Pack="true" PackagePath="/" />
    </ItemGroup>
  </Target>

</Project>
